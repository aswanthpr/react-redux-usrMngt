{
  "compilerOptions": {
    "target": "ES6", 
    "module": "commonjs",
    "rootDir": "./src", 
    "outDir": "./dist",
    "esModuleInterop": true, 
    "forceConsistentCasingInFileNames": true,          
    "strict": true,                               
    "skipLibCheck": true   ,
    "noImplicitAny": true,
    "allowImportingTsExtensions": null,                           
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
